<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0"
      prefWidth="420.0"
      prefHeight="500.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.farmacia.controller.RegistroLoteController">

    <padding>
        <Insets top="20.0"
                right="20.0"
                bottom="20.0"
                left="20.0"/>
    </padding>

    <children>

        <Label text="Registrar ingreso de medicamentos"/>

        <Label text="Medicamento"/>
        <ComboBox fx:id="cmbMedicamento"
                  promptText="Seleccione un medicamento"
                  maxWidth="Infinity"/>

        <Label text="Número de lote"/>
        <TextField fx:id="txtNumeroLote"
                   promptText="Ingrese el número de lote"/>

        <Label text="Cantidad recibida"/>
        <TextField fx:id="txtCantidad"
                   promptText="Ingrese la cantidad recibida"/>

        <Label text="Fecha de recepción"/>
        <DatePicker fx:id="dpFechaRecepcion"
                    promptText="Seleccione la fecha"
                    maxWidth="Infinity"/>

        <Label text="Fecha de vencimiento"/>
        <DatePicker fx:id="dpFechaVencimiento"
                    promptText="Seleccione la fecha"
                    maxWidth="Infinity"/>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#guardarLote"/>

                <Button fx:id="btnCancelar"
                        text="Cancelar"
                        onAction="#cancelar"/>
            </children>
        </HBox>

    </children>

</VBox>
