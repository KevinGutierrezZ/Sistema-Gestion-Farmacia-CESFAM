<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="12.0"
      prefWidth="400.0"
      prefHeight="450.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.farmacia.controller.RegistroMedicamentoController">

    <padding>
        <Insets top="20.0" right="20.0"
                bottom="20.0" left="20.0"/>
    </padding>

    <children>

        <Label text="Registrar medicamento"/>

        <Label text="Código"/>
        <TextField fx:id="txtCodigo"
                   promptText="Ingrese el código"/>

        <Label text="Nombre"/>
        <TextField fx:id="txtNombre"
                   promptText="Ingrese el nombre"/>

        <Label text="Descripción"/>
        <TextArea fx:id="txtDescripcion"
                  promptText="Ingrese una descripción"
                  prefRowCount="3"
                  wrapText="true"/>

        <Label text="Unidad de medida"/>
        <TextField fx:id="txtUnidadMedida"
                   promptText="Ej. Caja, comprimido, frasco"/>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#guardarMedicamento"/>
                <Button fx:id="btnCancelar"
                        text="Cancelar"
                        onAction="#cancelar"/>
            </children>
        </HBox>

    </children>

</VBox>
