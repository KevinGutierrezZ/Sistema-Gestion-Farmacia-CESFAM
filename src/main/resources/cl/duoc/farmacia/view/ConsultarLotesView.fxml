<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      prefWidth="750.0"
      prefHeight="450.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.farmacia.controller.ConsultarLotesController">

    <padding>
        <Insets top="20.0"
                right="20.0"
                bottom="20.0"
                left="20.0"/>
    </padding>

    <children>

        <Label fx:id="lblTitulo"
               text="Lotes del medicamento"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <TableView fx:id="tablaLotes"
                   prefHeight="350.0"
                   prefWidth="700.0">

            <columns>

                <TableColumn fx:id="colNumeroLote"
                             prefWidth="130.0"
                             text="Número de lote"/>

                <TableColumn fx:id="colCantidad"
                             prefWidth="90.0"
                             text="Cantidad"/>

                <TableColumn fx:id="colFechaRecepcion"
                             prefWidth="150.0"
                             text="Fecha de recepción"/>

                <TableColumn fx:id="colFechaVencimiento"
                             prefWidth="150.0"
                             text="Fecha de vencimiento"/>

            </columns>

        </TableView>

    </children>

</VBox>
